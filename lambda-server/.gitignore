# Lambda Execution Server - .gitignore
#
# Files to exclude from version control

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*

# Logs
*.log
logs/

# Temporary files
/tmp/
*.tmp
*.bak

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml

# Testing
.pytest_cache/
htmlcov/

# Type checking
.mypy_cache/
.pytype/

# Profiling
*.prof
*.profraw
*.profdata
