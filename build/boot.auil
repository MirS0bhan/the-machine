# Agentic desktop shell — SessionGreeting + chrome + workspace.
# Contract widget IDs (boot greet / chat send) must remain: ui.greeting, ui.chat_log,
# ui.chat_input, ui.chat_send. Agent-spawned controls land under #ui.workspace.
stack#ui.root dir=v gap=md
  stack#ui.chrome dir=h gap=lg
    text#ui.status_line(role=caption) "The Machine"
    text#ui.activity(role=caption) ""
  stack.SessionGreeting#ui.session dir=v gap=lg align=center
    text#ui.greeting(role=title size=title-2) "Welcome back"
    list#ui.chat_log(label=Conversation live=polite) ""
    field#ui.chat_input(input-mode=hybrid placeholder="Ask, request status, or place a control") ""
    button#ui.chat_send(variant=primary label=Send) on:press=mcp:agent.chat.send
  stack#ui.workspace dir=v gap=md
    text#ui.workspace_hint(role=caption) ""
